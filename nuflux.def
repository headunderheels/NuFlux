# nuflux.def
#
# Native Apptainer build for NuFlux (https://github.com/headunderheels/NuFlux)
# — no Docker required anywhere in this pipeline.
#
# Build (needs root or --fakeroot; see README-apptainer.md for the
# no-privilege-at-all Remote Builder option):
#   apptainer build --fakeroot nuflux.sif nuflux.def
#
# Run (interactive — the script uses input() prompts):
#   apptainer run --bind ./output:/work/output nuflux.sif
#
# NOTE ON STAGE STRUCTURE: unlike Docker's `FROM builder AS x`, Apptainer
# stages do NOT inherit each other's installed packages/state — each stage
# bootstraps fresh from its own Bootstrap/From line. Cross-stage reuse only
# happens via `%files from <stage>`, copying specific paths. So each build
# stage below repeats its own apt-get install rather than inheriting one
# "builder-base" stage, same net effect as the Dockerfile, different
# mechanism.
#
# VERSION PINS: same caveat as the Dockerfile — GEANT4/ROOT/BDSIM
# compatibility isn't pinned upstream. Adjust the version strings below
# (search for CLHEP_VERSION / GEANT4_VERSION / ROOT_VERSION / BDSIM_BRANCH
# mentions) if a stage fails to configure/build.

# =============================================================================
# Stage: root-install — prebuilt ROOT binary release
# =============================================================================
Bootstrap: docker
From: ubuntu:22.04
Stage: root-install

%post
    apt-get update && apt-get install -y --no-install-recommends wget ca-certificates
    cd /opt
    # ROOT prebuilt binary. This URL/filename is version- AND Ubuntu-point-
    # release- AND gcc-version-specific, and root.cern's naming changes between
    # releases — it is the single most likely line to need updating. Find the
    # current "Linux Ubuntu 22 (x86_64)" tarball URL at:
    #   https://root.cern/install/all_releases/
    # Override without editing this file by exporting APPTAINERENV_ROOT_URL
    # before building (Apptainer copies APPTAINERENV_* vars into %post):
    #   export APPTAINERENV_ROOT_URL="https://root.cern/download/root_v<...>.tar.gz"
    #   apptainer build --fakeroot nuflux.sif nuflux.def
    # Or just replace the default URL on the line below.
    # ROOT 6.34.10. This single ROOT serves BOTH the physics stack and GENIE
    # (built in the genie-build stage against this same ROOT), which is what
    # makes the pipeline single-container. Two requirements it must satisfy:
    #   1. PyROOT — the flux script does `import ROOT`. Standard root.cern
    #      binaries include it.
    #   2. GSL/MathMore — GENIE's configure hard-fails without it
    #      ("ROOT needs to be built with GSL/MathMore enabled"). root.cern's
    #      prebuilt binaries do include mathmore; verify after a version bump
    #      with: root-config --features | grep mathmore
    # 6.34.10 was verified reachable (HTTP 200); adjust for your target if
    # root.cern's filename differs — see https://root.cern/install/all_releases/
    ROOT_URL="${ROOT_URL:-https://root.cern/download/root_v6.34.10.Linux-ubuntu22.04-x86_64-gcc11.4.tar.gz}"
    echo "Fetching ROOT from: $ROOT_URL"
    # Fail fast with a clear message if the URL 404s, rather than letting
    # `wget -q` silently save an HTML error page and break `tar` cryptically.
    if ! wget -q --spider "$ROOT_URL"; then
        echo "ERROR: ROOT URL not reachable / not found (404?):" >&2
        echo "  $ROOT_URL" >&2
        echo "Fix it at https://root.cern/install/all_releases/ (Ubuntu 22 x86_64)" >&2
        echo "then re-run the build." >&2
        exit 1
    fi
    wget -q "$ROOT_URL" -O root.tar.gz
    tar -xzf root.tar.gz
    rm root.tar.gz
    # Result: /opt/root/

# =============================================================================
# Stage: clhep-build
# =============================================================================
Bootstrap: docker
From: ubuntu:22.04
Stage: clhep-build

%post
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake git ca-certificates
    mkdir -p /opt/build && cd /opt/build
    git clone --branch CLHEP_2_4_7_1 --depth 1 https://gitlab.cern.ch/CLHEP/CLHEP.git clhep-src
    mkdir clhep-build && cd clhep-build
    cmake ../clhep-src -DCMAKE_INSTALL_PREFIX=/opt/clhep
    make -j"$(nproc)"
    make install
    # Result: /opt/clhep/

# =============================================================================
# Stage: geant4-build — configured against the CLHEP build above
# =============================================================================
Bootstrap: docker
From: ubuntu:22.04
Stage: geant4-build

%files from clhep-build
    /opt/clhep /opt/clhep

%post
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake git ca-certificates \
        libexpat1-dev libxml2-dev libxerces-c-dev zlib1g-dev
        # Viz packages (qtbase5-dev, libqt5opengl5-dev, libmotif-dev, and the
        # libx*/libgl* GUI libs) were removed with the headless viz-off config
        # below. Re-add them here if you re-enable GEANT4_USE_QT/OPENGL_X11.
    mkdir -p /opt/build && cd /opt/build
    git clone --branch v11.2.1 --depth 1 https://github.com/Geant4/geant4.git geant4-src
    mkdir geant4-build && cd geant4-build
    cmake ../geant4-src \
        -DCMAKE_INSTALL_PREFIX=/opt/geant4 \
        -DGEANT4_INSTALL_DATA=ON \
        -DGEANT4_USE_SYSTEM_CLHEP=ON \
        -DCLHEP_ROOT_DIR=/opt/clhep \
        -DGEANT4_USE_GDML=ON \
        -DGEANT4_BUILD_MULTITHREADED=ON
        # GEANT4_USE_GDML=ON (needs libxerces-c-dev, installed above): BDSIM
        # auto-enables its own GDML support when it finds Xerces-C, then REQUIRES
        # the GEANT4 it links against to also have GDML — without this flag the
        # BDSIM cmake fails with "Geant4 was not compiled with GDML support".
        # Interactive visualization (Qt/OpenGL/X11) is OFF: this container runs
        # headless in --batch mode to generate flux files, so GEANT4's Qt/GL viz
        # is dead weight and pulls in extra deps (it was the Qt5OpenGL cmake
        # failure). To RE-ENABLE viz, add back:
        #     -DGEANT4_USE_OPENGL_X11=ON -DGEANT4_USE_QT=ON
        # AND install the viz dev packages in the apt line above:
        #     qtbase5-dev libqt5opengl5-dev libmotif-dev
        # (qtbase5-dev alone is NOT enough — Qt5OpenGL is a separate package.)
    make -j"$(nproc)"
    make install
    # Result: /opt/geant4/ — this is the slow stage (compile + physics data)

# =============================================================================
# Stage: bdsim-build — linked against GEANT4 + CLHEP + ROOT from prior stages
# =============================================================================
Bootstrap: docker
From: ubuntu:22.04
Stage: bdsim-build

%files from clhep-build
    /opt/clhep /opt/clhep
%files from geant4-build
    /opt/geant4 /opt/geant4
%files from root-install
    /opt/root /opt/root

%post
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake git ca-certificates \
        flex bison libtbb-dev \
        libexpat1-dev libxml2-dev libxerces-c-dev zlib1g-dev
        # flex + bison: BDSIM builds its GMAD lattice parser with them
        # (parser/CMakeLists.txt does find_package(BISON)/FLEX). Without them
        # BDSIM cmake fails with "Could NOT find BISON".
        # libtbb-dev: ROOT 6.34's libImt (implicit multithreading) links
        # against Intel TBB (libtbb.so.12). Without it, BDSIM executables that
        # link ROOT fail with "undefined reference to tbb::detail::..." /
        # "libtbb.so.12 not found". Runtime stage needs libtbb12 to match.
        # Headless: no Qt/Motif/X11 GUI dev libs. BDSIM auto-detects viz from
        # the GEANT4 it links against, and that GEANT4 was built viz-off, so
        # BDSIM builds headless too. If you re-enable GEANT4 viz, add the same
        # viz packages back here as well.
    export CLHEP_ROOT_DIR=/opt/clhep
    export G4INSTALL=/opt/geant4
    cd /opt
    # VERSION COMBINATION baked into this build:
    #   CLHEP 2.4.7.1 · GEANT4 v11.2.1 · ROOT 6.34.10 · BDSIM develop
    # BDSIM is the component that constrains this matrix. If the cmake below
    # fails, check BDSIM's docs for which GEANT4/ROOT it supports on your BDSIM
    # branch, and adjust the pins (CLHEP branch line ~73, GEANT4 ~97, ROOT_URL
    # ~46, BDSIM branch below). Pinning BDSIM to a released tag instead of
    # `develop` is often more stable than tracking the moving develop branch.
    git clone --recursive --branch develop --depth 1 \
        https://github.com/bdsim-collaboration/bdsim.git bdsim-src
    mkdir bdsim-build && cd bdsim-build
    # NOTE: geant4.sh / thisroot.sh use bash-only syntax (e.g. BASH_SOURCE),
    # but Apptainer runs %post under /bin/sh (dash), which errors with
    # "Bad substitution". Run the env-sourcing + configure/build under bash.
    bash -c '
        set -e
        . /opt/geant4/bin/geant4.sh
        . /opt/root/bin/thisroot.sh
        cmake ../bdsim-src -DCMAKE_INSTALL_PREFIX=/opt/bdsim
        make -j"$(nproc)"
        make install
    '
    # Result: /opt/bdsim/

# =============================================================================
# Stage: genie-build
# Builds GENIE and its external dependencies (LHAPDF, Pythia6) against the SAME
# ROOT this image ships, so GENIE's libraries are ABI-compatible with it. This
# is what lets the pipeline run in ONE container: the flux script needs both
# PyROOT (to run) and GENIE's libGTlFlx (to write the gsimple output).
#
# GENIE hard-requires ROOT built with GSL/MathMore — root.cern's prebuilt
# binaries include mathmore, which is why the prebuilt ROOT in root-install
# works here (verified: `root-config --features` lists mathmore).
#
# Dependency sources (all verified reachable from %post at build time):
#   GENIE   : github.com/GENIE-MC/Generator  (pinned tag)
#   LHAPDF  : lhapdf.hepforge.org            (not packaged in Ubuntu)
#   Pythia6 : fetched by GENIE's own build_pythia6.sh helper
#   log4cpp/libxml2/GSL : Ubuntu packages
# NOTE: GENIE's build_ext.sh orchestrator pulls from a personal academic URL
# (hepunx.rl.ac.uk) that 301-redirects to a dead target — do NOT use it. Call
# the individual helper (build_pythia6.sh) and build LHAPDF directly instead.
# =============================================================================
Bootstrap: docker
From: ubuntu:22.04
Stage: genie-build

%files from root-install
    /opt/root /opt/root

%post
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential make cmake git wget curl ca-certificates \
        gfortran \
        libgsl-dev liblog4cpp5-dev libxml2-dev zlib1g-dev \
        libtbb-dev libfreetype6 \
        python3 python3-dev
        # gfortran: Pythia6 is Fortran — without it build_pythia6.sh fails.
        # libgsl-dev: GENIE compiles against GSL headers. NOTE the runtime GSL
        #   libs are already pulled in by ROOT's mathmore, but the -dev headers
        #   are NOT in the base image, so they must be installed here.
        # liblog4cpp5-dev / libxml2-dev: GENIE lists both as "always needed".
        # libtbb-dev: ROOT's libImt links Intel TBB. Anything that links ROOT
        # — including GENIE's apps — fails with "undefined reference to
        # tbb::detail::r1::..." without it. Same requirement as bdsim-build.

    # ---- versions (override with APPTAINERENV_* at build time) -------------
    GENIE_TAG="${GENIE_TAG:-R-3_04_02}"        # matches GENIE 3.04.02
    LHAPDF_VER="${LHAPDF_VER:-6.5.6}"          # latest listed on hepforge
    PYTHIA6_VER="${PYTHIA6_VER:-6.4.28}"       # build_pythia6.sh default

    # ---- LHAPDF (from source; not in Ubuntu repos) -------------------------
    cd /opt
    LHAPDF_URL="https://lhapdf.hepforge.org/downloads/?f=LHAPDF-${LHAPDF_VER}.tar.gz"
    echo "Fetching LHAPDF from: $LHAPDF_URL"
    if ! wget -q -O lhapdf.tar.gz "$LHAPDF_URL"; then
        echo "ERROR: could not download LHAPDF ${LHAPDF_VER}." >&2
        echo "  Check the current version list at https://lhapdf.hepforge.org/downloads/" >&2
        echo "  and override with APPTAINERENV_LHAPDF_VER=<version>." >&2
        exit 1
    fi
    tar -xzf lhapdf.tar.gz && rm lhapdf.tar.gz
    cd "LHAPDF-${LHAPDF_VER}"
    ./configure --prefix=/opt/lhapdf --disable-python
    make -j"$(nproc)" && make install
    cd /opt && rm -rf "LHAPDF-${LHAPDF_VER}"
    # Result: /opt/lhapdf/

    # ---- GENIE source ------------------------------------------------------
    cd /opt
    git clone --depth 1 --branch "$GENIE_TAG" \
        https://github.com/GENIE-MC/Generator.git genie-src
    export GENIE=/opt/genie-src

    # ---- Pythia6 --------------------------------------------------------
    # GENIE's build_pythia6.sh is used ONLY to fetch the sources. Its actual
    # library build fails on modern systems: it calls `fsplit` (not packaged in
    # Ubuntu) to split pythia6428.f into per-routine files, build a static
    # liblund.a, and link the .so from that. Without fsplit it silently
    # produces a ~16 KB stub containing just the C wrapper — which links fine
    # but has NO Pythia6 symbols, failing much later inside GENIE.
    # We therefore ignore its output and compile the shared library directly
    # from the downloaded sources, which also sidesteps the BLOCK DATA/PYDATA
    # problem the split existed to solve (linking objects straight into a .so
    # includes block data unconditionally, unlike pulling from a static archive).
    mkdir -p /opt/pythia6-build && cd /opt/pythia6-build
    bash "$GENIE/src/scripts/build/ext/build_pythia6.sh" "$PYTHIA6_VER" || true

    P6SRC=$(find /opt/pythia6-build -name "pythia6*.f" | head -1)
    P6WRAPF=$(find /opt/pythia6-build -name "tpythia6_called_from_cc.F" | head -1)
    P6WRAPC=$(find /opt/pythia6-build -name "pythia6_common_address.c" | head -1)
    if [ -z "$P6SRC" ] || [ -z "$P6WRAPF" ] || [ -z "$P6WRAPC" ]; then
        echo "ERROR: Pythia6 sources not downloaded by build_pythia6.sh." >&2
        echo "  Looked for pythia6*.f, tpythia6_called_from_cc.F," >&2
        echo "  pythia6_common_address.c under /opt/pythia6-build." >&2
        exit 1
    fi

    mkdir -p /opt/pythia6/lib
    # -fcommon is REQUIRED: GCC 10+ defaults to -fno-common, which makes the C
    # wrapper's globals collide with the Fortran COMMON blocks
    # ("multiple definition of `pydat1_'"). Do NOT remove.
    gcc -c -fPIC -O2 -fcommon -o /tmp/pythia6_common_address.o "$P6WRAPC"
    gfortran -shared -fPIC -O2 -fno-second-underscore \
        -o /opt/pythia6/lib/libPythia6.so \
        "$P6SRC" "$P6WRAPF" /tmp/pythia6_common_address.o

    # Guard properly: a stub also "exists", so check size AND symbols.
    P6SIZE=$(stat -c%s /opt/pythia6/lib/libPythia6.so 2>/dev/null || echo 0)
    if [ "$P6SIZE" -lt 500000 ] || ! nm -D /opt/pythia6/lib/libPythia6.so | grep -q "pyinit_"; then
        echo "ERROR: libPythia6.so looks empty (${P6SIZE} bytes, no pyinit_ symbol)." >&2
        echo "  A real library is ~2.6 MB. Check the gfortran output above." >&2
        exit 1
    fi

    # ---- ROOT's TPythia6 interface (libEGPythia6) ---------------------------
    # GENIE includes <TPythia6.h> in its CORE framework (Framework/Numerical/
    # RandomGen.cxx, Decay/, Hadronization/, HELepton/) and links -lEGPythia6
    # unconditionally (src/make/Make.include:265). There is no --disable-pythia6
    # and switching to Pythia8 does NOT remove this — Pythia6 is hard-wired.
    #
    # That class is ROOT's Pythia6 module — and ROOT **REMOVED it in 6.32**:
    #   ROOT 6.28, 6.30  -> montecarlo/pythia6 present
    #   ROOT 6.32, 6.34  -> removed entirely
    # So it cannot be built from this image's own ROOT (6.34) sources. Instead
    # take the module from the LAST ROOT release that shipped it (6.30) and
    # compile it against the installed 6.34. That works because everything the
    # module depends on still exists in 6.34: TPythia6 derives from TGenerator
    # and TPythia6Decayer from TVirtualMCDecayer, both still provided by
    # montecarlo/eg in 6.34 (verified).
    #
    # (This is also why the reference GENIE container used ROOT 6.28 — it was
    # custom-built with pythia6 enabled. Stock root.cern binaries never ship it,
    # so downgrading ROOT alone would not help; the module must be built either
    # way.)
    ROOT_PYTHIA6_TAG="${ROOT_PYTHIA6_TAG:-v6-30-06}"   # last ROOT with montecarlo/pythia6
    cd /opt
    git clone --depth 1 --branch "$ROOT_PYTHIA6_TAG" --filter=blob:none --sparse \
        https://github.com/root-project/root.git root-src
    cd root-src && git sparse-checkout set montecarlo/pythia6
    if [ ! -f montecarlo/pythia6/inc/TPythia6.h ]; then
        echo "ERROR: TPythia6 sources not found in ROOT $ROOT_PYTHIA6_TAG." >&2
        echo "  Expected /opt/root-src/montecarlo/pythia6/inc/TPythia6.h" >&2
        echo "  ROOT removed this module in 6.32 — ROOT_PYTHIA6_TAG must be a" >&2
        echo "  release that still has it (6.30.x or 6.28.x)." >&2
        exit 1
    fi
    bash -c '
        set -e
        . /opt/root/bin/thisroot.sh
        cd /opt/root-src/montecarlo/pythia6
        mkdir -p build && cd build
        # Headers to dictionary-ify: everything except LinkDef (which must come last).
        HDRS=$(ls ../inc/*.h | grep -v LinkDef || true)
        rootcling -f G__EGPythia6.cxx \
            -rmf libEGPythia6.rootmap -rml libEGPythia6.so \
            -I../inc $HDRS ../inc/LinkDef.h
        # Build all module sources + the generated dictionary into one shared lib.
        g++ -shared -fPIC -O2 -std=c++17 $(root-config --cflags) -I../inc \
            ../src/*.cxx G__EGPythia6.cxx \
            -o libEGPythia6.so \
            $(root-config --libs) -lEG \
            -L/opt/pythia6/lib -lPythia6 -lgfortran
        # Install into ROOT so that GENIE (which relies on root-config --glibs
        # supplying -L/opt/root/lib) finds -lEGPythia6 and <TPythia6.h>.
        cp libEGPythia6.so /opt/root/lib/
        cp libEGPythia6.rootmap /opt/root/lib/ 2>/dev/null || true
        cp *_rdict.pcm /opt/root/lib/ 2>/dev/null || true
        cp ../inc/*.h /opt/root/include/
    '
    if [ ! -f /opt/root/lib/libEGPythia6.so ] || [ ! -f /opt/root/include/TPythia6.h ]; then
        echo "ERROR: libEGPythia6.so / TPythia6.h were not installed into /opt/root." >&2
        echo "  GENIE's build will fail on '#include <TPythia6.h>' without them." >&2
        exit 1
    fi
    # Stage a copy (plus its Cling dictionary files) under a directory the final
    # stage copies wholesale. The final image's /opt/root comes from the
    # root-install stage and so lacks anything added here; /opt/genie is copied
    # from THIS stage and is first on LD_LIBRARY_PATH at run time. Wildcards are
    # used because the generated .pcm/.rootmap names vary by ROOT version, which
    # would make an explicit %files entry brittle.
    mkdir -p /opt/genie/lib
    cp /opt/root/lib/libEGPythia6.so /opt/genie/lib/
    cp /opt/root-src/montecarlo/pythia6/build/libEGPythia6.rootmap /opt/genie/lib/ 2>/dev/null || true
    cp /opt/root-src/montecarlo/pythia6/build/*_rdict.pcm /opt/genie/lib/ 2>/dev/null || true

    # ---- GENIE itself, configured against THIS ROOT ------------------------
    cd "$GENIE"
    bash -c '
        set -e
        . /opt/root/bin/thisroot.sh
        export GENIE=/opt/genie-src
        export PYTHIA6=/opt/pythia6/lib
        export LHAPDF6_INC=/opt/lhapdf/include
        export LHAPDF6_LIB=/opt/lhapdf/lib
        ./configure \
            --prefix=/opt/genie \
            --enable-lhapdf6 \
            --enable-flux-drivers \
            --enable-geom-drivers \
            --with-pythia6-lib=/opt/pythia6/lib \
            --with-lhapdf6-inc=/opt/lhapdf/include \
            --with-lhapdf6-lib=/opt/lhapdf/lib
        make -j"$(nproc)"
        make install
    '
    # Sanity: the pipeline needs libGTlFlx (GENIE flux drivers, hence
    # --enable-flux-drivers above). Fail the build here rather than at runtime.
    if ! find /opt/genie /opt/genie-src -name "libGTlFlx*" | grep -q .; then
        echo "ERROR: GENIE built but libGTlFlx was not produced." >&2
        echo "  The gsimple output step needs it. Check that ./configure kept" >&2
        echo "  --enable-flux-drivers and review the GENIE build log above." >&2
        exit 1
    fi
    # Result: /opt/genie/ (+ /opt/lhapdf, /opt/pythia6)

# =============================================================================
# Final stage — runtime image
# =============================================================================
Bootstrap: docker
From: ubuntu:22.04
Stage: final

%files from clhep-build
    /opt/clhep /opt/clhep
%files from root-install
    /opt/root /opt/root
%files from geant4-build
    /opt/geant4 /opt/geant4
%files from bdsim-build
    /opt/bdsim /opt/bdsim
%files from genie-build
    /opt/genie /opt/genie
    /opt/lhapdf /opt/lhapdf
    /opt/pythia6 /opt/pythia6
    /opt/root/lib/libEGPythia6.so /opt/root/lib/libEGPythia6.so
    /opt/root/include/TPythia6.h /opt/root/include/TPythia6.h

%files
    patches/patch_pybdsim.py /opt/patch_pybdsim.py

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip \
        g++ libstdc++-11-dev \
        libexpat1 libxml2 libxerces-c3.2 libtbb12 \
        liblog4cpp5v5 libgsl27 libgfortran5 libfreetype6 \
        zlib1g wget git ca-certificates
        # libfreetype6: NOT for graphics. libEGPythia6 (and GENIE, which links
        # `root-config --glibs`) reference ROOT's Graf/Gpad libs, which need
        # freetype at LOAD time even though nothing ever draws. Without it,
        # gSystem->Load("libEGPythia6") fails with
        # "libfreetype.so.6: cannot open shared object file".
        # liblog4cpp5v5 / libgsl27 / libgfortran5: RUNTIME counterparts of the
        # -dev packages used in genie-build. GENIE links log4cpp and GSL, and
        # Pythia6 is Fortran (needs libgfortran at run time). Without these the
        # GENIE libraries fail to load with "liblog4cpp.so.5: cannot open
        # shared object file" / similar, even though they built fine.
        # g++ + libstdc++-11-dev: REQUIRED at runtime, not just build time.
        # ROOT's Cling is a JIT C++ interpreter; PyROOT (`import ROOT`) makes
        # Cling compile C++ on the fly, so it needs the C++ standard-library
        # headers (<new>, <vector>, ...) present in the final image. Without
        # them `import ROOT` aborts with "cannot extract standard library
        # include paths / 'new' file not found". This is the runtime stage, so
        # they must be installed HERE (the build stages having them isn't
        # enough — this is a fresh ubuntu:22.04 layer).
        # libtbb12: runtime counterpart of libtbb-dev in the build stage —
        # ROOT's libImt needs libtbb.so.12 present at run time too.
        # Headless runtime: dropped libmotif4, libqt5widgets5, and the libx*/
        # libgl* runtime libs that only existed for GEANT4's Qt/OpenGL viz
        # (built viz-off). Re-add them here if you re-enable viz in the build.
    rm -rf /var/lib/apt/lists/*

    # MAD-X: prebuilt static binary, per the upstream README
    mkdir -p /opt/madx
    wget -q https://madx.web.cern.ch/madx/releases/last-rel/madx-linux64-gnu \
        -O /opt/madx/madx-linux64-gnu
    chmod +x /opt/madx/madx-linux64-gnu

    # Python deps + the muon/antimuon patch for pybdsim
    # generate_nu_flux.py imports pybdsim, uproot, numpy, awkward (ROOT from
    # the /opt/root install). Upstream README lists only pybdsim/pymadx.
    pip install --no-cache-dir pybdsim pymadx uproot numpy awkward
    python3 /opt/patch_pybdsim.py

    # Mount point for a bind-mounted GENIE install (see %environment). Must
    # exist in the read-only image for `apptainer run --bind ...:/opt/genie`
    # to attach onto it. Empty unless you mount GENIE there at run time.
    mkdir -p /opt/genie

    # NuFlux itself + the accelerator geometry repo it needs alongside it
    mkdir -p /work
    cd /work
    git clone https://github.com/headunderheels/NuFlux.git .
    git clone https://gitlab.cern.ch/acc-models/acc-models-mc.git

%environment
    # NOTE: %environment is sourced by /bin/sh at RUN time, so it must NOT
    # `source` geant4.sh/thisroot.sh (bash-only syntax -> "Bad substitution").
    # We set the variables those scripts would set, directly, instead. The
    # %runscript re-sources them under bash for anything not covered here.
    export MADX=/opt/madx/madx-linux64-gnu
    export ROOTSYS=/opt/root
    export G4INSTALL=/opt/geant4
    # GENIE is built INTO this image (see the genie-build stage), together with
    # its LHAPDF and Pythia6 dependencies, all against this image's ROOT. That
    # is what makes the pipeline single-container: generate_nu_flux.py can both
    # `import ROOT` (PyROOT) and ROOT.gSystem.Load("libGTlFlx") in one process.
    # $GENIE is GENIE's own conventional root-dir variable; its tools expect it.
    export GENIE=/opt/genie
    export GENIE_LIB=/opt/genie/lib
    # GENIE's ROOT dictionaries reference its headers as
    # "Framework/Algorithm/AlgStatus.h" etc., i.e. relative to the GENIE
    # include root. Without this, Cling prints "Missing FileEntry for ..."
    # for every GENIE class and cannot JIT anything needing full definitions.
    export ROOT_INCLUDE_PATH=/opt/genie/include/GENIE:${ROOT_INCLUDE_PATH}
    export LHAPATH=/opt/lhapdf/share/LHAPDF
    export LD_LIBRARY_PATH=${GENIE_LIB}:/opt/lhapdf/lib:/opt/pythia6/lib:/opt/clhep/lib:/opt/root/lib:/opt/geant4/lib:/opt/bdsim/lib:${LD_LIBRARY_PATH}
    export PATH=/opt/genie/bin:/opt/root/bin:/opt/geant4/bin:/opt/bdsim/bin:/opt/madx:${PATH}

%runscript
    #!/bin/bash
    # Source GEANT4/ROOT under bash (their init scripts use bash-only syntax).
    # This sets the GEANT4 data-file env vars (G4LEDATA etc.) the simulation
    # needs — PATH/LD_LIBRARY_PATH are already set in %environment.
    source /opt/geant4/bin/geant4.sh
    source /opt/root/bin/thisroot.sh
    [ -f /opt/bdsim/bin/bdsim.sh ] && source /opt/bdsim/bin/bdsim.sh

    if [ -z "$MADX" ]; then
        echo "WARNING: \$MADX not set — generate_nu_flux.py will fall back to a" >&2
        echo "hardcoded path and likely fail to find MAD-X." >&2
    fi

    # GENIE pre-flight: GENIE is built into this image, so libGTlFlx should
    # always be present. If it isn't, the image is broken (bad build or a bind
    # shadowing /opt/genie) — say so plainly rather than letting the script die
    # later with a bare "Could not load GENIE's libGTlFlx".
    if ! ls "${GENIE_LIB:-/opt/genie/lib}"/libGTlFlx* >/dev/null 2>&1; then
        echo "WARNING: libGTlFlx not found under \$GENIE_LIB=${GENIE_LIB:-/opt/genie/lib}." >&2
        echo "GENIE ships inside this image, so this indicates a problem: either the" >&2
        echo "image was built without --enable-flux-drivers, or a bind-mount is" >&2
        echo "shadowing /opt/genie. The GEANT4 output will still be written, but the" >&2
        echo "GENIE 'gsimple' step will fail." >&2
    fi

    # generate_nu_flux.py resolves geometry via CWD-relative paths, e.g.
    #   collider_dir = "acc-models-mc/collider/10_TeV/"
    # so run from /work with acc-models-mc beside the script. In this
    # from-source image /work is baked in at build time, but if you bind-mount
    # over it, keep the script + acc-models-mc together.
    cd /work
    exec python3 generate_nu_flux.py "$@"

%labels
    Author you
    Description Containerized NuFlux (GEANT4/BDSIM/MAD-X neutrino flux generator)
